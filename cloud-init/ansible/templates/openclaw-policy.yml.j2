version: 1
filesystem_policy:
  include_workdir: true
  read_only:
    - /usr
    - /lib
    - /lib64
    - /etc
    - /proc
    - /dev/urandom
    - /app
{% if openclaw_demo_csb_enabled_cfg | bool %}
    - /opt/m365
{% else %}
    - /opt
{% endif %}
    - /var/log
  read_write:
    - /sandbox
    - /tmp
    - /dev/null
    - /dev/pts
landlock:
  compatibility: best_effort
process:
  run_as_user: "{{ openclaw_sandbox_uid_cfg }}"
  run_as_group: "{{ openclaw_sandbox_gid_cfg }}"
